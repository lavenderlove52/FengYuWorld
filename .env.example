APP_ENV=development

# ntfy Android 推送
# 对外地址：用于生成手机订阅地址，例如 http://124.223.116.8/blog-my-phone
NTFY_BASE_URL=http://124.223.116.8
# 内部地址：博客后端通过本机 ntfy 服务发送消息
NTFY_INTERNAL_URL=http://127.0.0.1:10002
# 所有网页推送统一使用 blog 用户鉴权
NTFY_USERNAME=blog
# 推荐填写 blog 用户的访问令牌；使用令牌时保持 NTFY_PASSWORD 为空
NTFY_ACCESS_TOKEN=
# 也可填写 blog 用户密码；使用密码时保持 NTFY_ACCESS_TOKEN 为空
NTFY_PASSWORD=

# 用户保存话题时，博客后端执行：ntfy access blog blog-xxx rw
NTFY_CLI_PATH=ntfy
# 必填：ntfy access 直接编辑的认证数据库，须与 server.yml 的 auth-file 完全一致
NTFY_AUTH_FILE=/var/lib/ntfy/user.db
# ntfy 直接安装时留空；使用 Docker 时填写 ntfy 容器名
NTFY_DOCKER_CONTAINER=

APP_PORT=8080
DATABASE_URL=postgres://myblog:myblog@localhost:5432/myblog?sslmode=disable
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=168h
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=/uploads
MAX_IMAGE_SIZE_MB=5

# QQ 邮箱 SMTP（注册验证码）
# 在 QQ 邮箱 → 设置 → 账户 → POP3/SMTP → 开启服务 → 生成「授权码」（不是 QQ 密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASS=16位授权码
SMTP_FROM=你的QQ邮箱@qq.com
