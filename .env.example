APP_ENV=development
# ntfy Android push. Prefer an access token; password is the fallback.
NTFY_BASE_URL=http://124.223.116.8
# Backend-only address. Useful when ntfy listens on loopback.
NTFY_INTERNAL_URL=http://127.0.0.1:10002
NTFY_USERNAME=blog
NTFY_ACCESS_TOKEN=
NTFY_PASSWORD=

# Backend runs: ntfy --config <file> access blog <topic> rw
# The CLI must use the same auth database as the ntfy server.
NTFY_CLI_PATH=ntfy
NTFY_CONFIG_FILE=
# If ntfy runs in Docker, set its container name. Backend will use docker exec.
NTFY_DOCKER_CONTAINER=

APP_PORT=8080
DATABASE_URL=postgres://myblog:myblog@localhost:5432/myblog?sslmode=disable
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=168h
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=/uploads
MAX_IMAGE_SIZE_MB=5

# QQ 邮箱 SMTP（注册验证码）
# 在 QQ 邮箱 → 设置 → 账户 → POP3/SMTP → 开启服务 → 生成「授权码」（不是 QQ 密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASS=16位授权码
SMTP_FROM=你的QQ邮箱@qq.com
